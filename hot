  <script>
    // Contador regressivo de urgência
    let minutes = 4;
    let seconds = 59;
    const countdownEl = () => document.getElementById('countdown');

    function updateCountdown() {
      if (seconds === 0) {
        if (minutes === 0) {
          countdownEl().innerHTML = "Tempo esgotado! Recarregue para tentar de novo.";
          return;
        }
        minutes--;
        seconds = 59;
      } else {
        seconds--;
      }
      countdownEl().innerHTML = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
      setTimeout(updateCountdown, 1000);
    }

    // Função de roleta
    function spinRoulette() {
      const reward = Math.random();
      let rewardText = "";
      if (reward < 0.2) {
        rewardText = "50% OFF! 🎉";
      } else if (reward < 0.4) {
        rewardText = "Bônus exclusivo! 💥";
      } else {
        rewardText = "Acesso VIP Garantido! 🔥";
      }

      const rouletteWheel = document.querySelector('.roulette-wheel');
      rouletteWheel.innerHTML = `<span>${rewardText}</span>`;
      
      // Adiciona efeito sonoro de recompensa
      const audio = new Audio('https://www.soundjay.com/button/beep-07.wav');
      audio.play();
    }

    window.onload = function() {
      updateCountdown();
    };
